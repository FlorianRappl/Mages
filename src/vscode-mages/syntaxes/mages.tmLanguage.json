{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MAGES",
  "scopeName": "source.mages",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#jsx"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.mages",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mages",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.mages",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mages",
              "match": "\\\\([\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.mages",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.mages",
              "match": "\\\\(['\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.interpolated.mages",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.mages",
              "match": "\\\\[`\\\\]"
            },
            {
              "name": "punctuation.definition.template-expression.begin.mages",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mages",
          "match": "\\b(if|else|while|for|return|break|continue|match|var|let|const|new|await|delete|yield)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.mages",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.mages",
          "match": "\\b(null|undefined|nil)\\b"
        },
        {
          "name": "constant.language.math.mages",
          "match": "\\b(PI|E|Infinity|NaN|I)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.mages",
          "match": "\\b0[xX][0-9a-fA-F]+(\\.[0-9a-fA-F]+)?([pP][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.binary.mages",
          "match": "\\b0[bB][01]+(\\.[01]+)?\\b"
        },
        {
          "name": "constant.numeric.octal.mages",
          "match": "\\b0[oO][0-7]+(\\.[0-7]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.mages",
          "match": "\\b[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.mages",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.mages",
          "match": "(==|~=|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.mages",
          "match": "(&&|\\|\\||!|~)"
        },
        {
          "name": "keyword.operator.range.mages",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.mages",
          "match": "(\\+\\+|--|\\+|-|\\*|/|\\\\|\\^|%|\\|)"
        },
        {
          "name": "keyword.operator.assignment.mages",
          "match": "(=)"
        }
      ]
    },
    "jsx": {
      "patterns": [
        {
          "name": "meta.tag.mages",
          "begin": "<([a-zA-Z0-9_\\-\\.]+)",
          "beginCaptures": {
            "1": {
              "name": "entity.name.tag.mages"
            }
          },
          "end": "(/?>)",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "name": "entity.other.attribute-name.mages",
              "match": "\\b([a-zA-Z0-9_\\-]+)\\b"
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.tag.close.mages",
          "match": "</([a-zA-Z0-9_\\-\\.]*)>",
          "captures": {
            "1": {
              "name": "entity.name.tag.mages"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.mages",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.mages",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
