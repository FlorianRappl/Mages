---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "MAGES - A lightweight, ultra-fast expression parser, compiler, and interpreter for .NET" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={`${baseUrl}logo.png`} />
    <title>{title} | MAGES</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="header">
      <div class="container nav-container">
        <a href={baseUrl} class="logo-link">
          <img src={`${baseUrl}logo.png`} alt="MAGES Logo" class="logo-img" />
          <span class="logo-text">MAGES</span>
        </a>
        <nav class="nav-links">
          <a href={`${baseUrl}docs/introduction`}>Documentation</a>
          <a href="https://github.com/FlorianRappl/MAGES" target="_blank" rel="noopener noreferrer" class="github-link" aria-label="GitHub repository" title="GitHub">
            <svg height="20" width="20" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-content">
        <p>© 2016-{new Date().getFullYear()} Florian Rappl. Released under the MIT License.</p>
        <div class="footer-links">
          <a href="https://www.nuget.org/packages/Mages/" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="NuGet Package" title="NuGet Package">
            <svg height="19" width="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7.5 4.27 9 5.15"/>
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
              <path d="m3.3 7 8.7 5 8.7-5"/>
              <path d="M12 22V12"/>
            </svg>
          </a>
          <a href="https://github.com/FlorianRappl/MAGES" target="_blank" rel="noopener noreferrer" class="footer-icon-link" aria-label="GitHub repository" title="GitHub">
            <svg height="19" width="19" viewBox="0 0 16 16" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
          <a href={`${baseUrl}docs/introduction`} class="footer-icon-link" aria-label="Documentation" title="Documentation">
            <svg height="19" width="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
              <path d="M6 6h10"/>
              <path d="M6 10h10"/>
            </svg>
          </a>
        </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #9333ea;
    --primary-light: #c084fc;
    --primary-dark: #6b21a8;
    --accent: #38bdf8;
    --bg-main: #0a0b10;
    --bg-card: #13151f;
    --bg-card-hover: #1c1f2e;
    --text-main: #f3f4f6;
    --text-muted: #9ca3af;
    --border: #232738;
    --radius: 10px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background-color: var(--bg-main);
    color: var(--text-main);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  code, pre {
    font-family: 'Fira Code', monospace;
  }

  a {
    color: var(--primary-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--accent);
  }

  .header {
    background: rgba(10, 11, 16, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    color: var(--text-main);
  }

  .logo-img {
    height: 38px;
    width: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--text-main);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-main) !important;
    transition: all 0.2s;
  }

  .github-link:hover {
    border-color: var(--primary-light);
    transform: translateY(-2px);
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
    margin-top: 4rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted) !important;
    transition: all 0.2s;
  }

  .footer-icon-link:hover {
    color: var(--text-main) !important;
    border-color: var(--primary-light);
    transform: translateY(-2px);
  }
</style>
